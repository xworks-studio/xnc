# 凭据与环境（严禁入库）
deploy/machines.env
*.pem
*.key
.env.*
deploy/.env
!deploy/.env.example

# 构建产物
bin/
dist/
target/
node_modules/

# go:embed 编译期占位：server/web/dist 需入库（web_embed.go 引用），
# 但只跟踪占位文件；真实 Vite 产物（assets/* 等）仍忽略。
!server/web/dist/
server/web/dist/*
!server/web/dist/index.html
!server/web/dist/.gitkeep

# IDE / 系统
.idea/
.vscode/
*.log

.worktrees/

/bin/
*.exe
__pycache__/

# 误提交的 ELF 构建产物
agent/screen-helper/screen-helper
