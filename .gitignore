# 凭据与环境（严禁入库）
*.pem
*.key
.env.*
deploy/.env
!deploy/.env.example

# 构建产物
bin/
dist/
target/
node_modules/

# go:embed 编译期占位：src/server/web/dist 需入库（web_embed.go 引用），
# 但只跟踪占位文件；真实 Vite 产物（assets/* 等）仍忽略。
!src/server/web/dist/
src/server/web/dist/*
!src/server/web/dist/index.html
!src/server/web/dist/.gitkeep

# IDE / 系统
.idea/
.vscode/
*.log

.worktrees/

/bin/
*.exe
__pycache__/
*.obj

# 测量产物（M4 才有意入库精选 gate 记录；日常记录见 SDD 任务报告）
artifacts/

# 代码签名私钥（仅本地，勿入库）
src/installer/codesign.pfx

# Rust（xnc-host / vendored scrap）
src/host/target/
src/third_party/scrap/src/generated/

# RTV 研究期 MVP 源（已迁移进 host/server/web；原品保留于 desktop-reserch）
mvp/
