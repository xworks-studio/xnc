[Unit]
Description=XNC RTV media relay (relay-plane)
After=network-online.target
Wants=network-online.target

[Service]
# 参数由 deploy/push_relay.py 渲染（{{SERVER_URL}}/{{PUBLIC_HOST}}/
# {{REGION}}/{{MAX_SESSIONS}}/{{MAX_MBPS_OUT}}/{{ALLOW_ORIGIN}}/
# {{SESSION_HOST}}/{{SESSION_PORT}}）。
# HTTP 腿（/ws 浏览器兜底 + /healthz + 会话数据腿，默认 127.0.0.1:8080）：
# 生产由主机 caddy 前置终结 TLS（TCP443 → 127.0.0.1:8080，需域名 + CA
# 证书——浏览器 WS 无法钉扎自签）；--ws-port 443 为 WS 兜底对外端口。
# --session-host 非空才宣告会话数据面（exec/shell/file/tunnel 走本
# relay；DNS 就绪 + caddy 前置到位后填，如 r1.xnc.app）。
ExecStart=/usr/local/bin/xnc-relay \
  --server {{SERVER_URL}} \
  --public-host {{PUBLIC_HOST}} \
  --data-dir /var/lib/xnc-relay \
  --region {{REGION}} \
  --allow-origin {{ALLOW_ORIGIN}} \
  --max-sessions {{MAX_SESSIONS}} \
  --max-mbps-out {{MAX_MBPS_OUT}} \
  --http-addr 127.0.0.1:8080 \
  --ws-port 443 \
  --session-host {{SESSION_HOST}} \
  --session-port {{SESSION_PORT}}
Restart=always
RestartSec=2

# 加固：只保留低端口绑定能力，锁文件系统视野。
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=xnc-relay

[Install]
WantedBy=multi-user.target
