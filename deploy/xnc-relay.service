[Unit]
Description=XNC RTV media relay (relay-plane)
After=network-online.target
Wants=network-online.target

[Service]
# 参数由 deploy/push_relay.py 渲染（{{SERVER_URL}}/{{PUBLIC_HOST}}/
# {{REGION}}/{{MAX_SESSIONS}}/{{MAX_MBPS_OUT}}）。
ExecStart=/usr/local/bin/xnc-relay \
  --server {{SERVER_URL}} \
  --public-host {{PUBLIC_HOST}} \
  --data-dir /var/lib/xnc-relay \
  --region {{REGION}} \
  --allow-origin {{ALLOW_ORIGIN}} \
  --max-sessions {{MAX_SESSIONS}} \
  --max-mbps-out {{MAX_MBPS_OUT}}
Restart=always
RestartSec=2

# 加固：只保留低端口绑定能力，锁文件系统视野。
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=xnc-relay

[Install]
WantedBy=multi-user.target
