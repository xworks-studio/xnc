# XNC deploy/.env 统一模板 —— cp .env.example .env 后填入真实值
#
# 两部分：
#   1. dev 栈密钥（本地 docker compose e2e：docker-compose.yml 用 ${VAR} 从 deploy/.env 取值）
#   2. 测试设备凭据（spec §59 测试设备矩阵；开发脚本与 AI Agent 统一从中读取）
# deploy/.env 已被 .gitignore 排除，严禁提交。
XNC_DOMAIN=control.example.com
POSTGRES_PASSWORD=change-me-pg
XNC_JWT_SECRET=change-me-at-least-32-bytes-long!!
XNC_ADMIN_EMAIL=admin@example.com
XNC_ADMIN_PASSWORD=change-me
#
# ── 测试设备凭据（spec §59 测试设备矩阵）──
#
# 用法：cd deploy && cp .env.example .env && 填入真实值
# deploy/.env 已被 .gitignore 排除，严禁提交；开发脚本与 AI Agent 从中读取。
# 未启用的设备整节留空——脚本检测到 HOST 为空即跳过对应测试。
# 认证二选一：*_SSH_PASSWORD 或 *_SSH_KEY_PATH（密钥优先）。

# ── SRV：公网控制服务器（Ubuntu，阿里云国际区域）──
# 用途：xnc-server / Caddy / PostgreSQL 真机部署验证；NAT 场景对端
SRV_SSH_HOST=47.243.209.52
SRV_SSH_PORT=22
SRV_SSH_USER=root
SRV_SSH_PASSWORD=
SRV_SSH_KEY_PATH=
SRV_DOMAIN=control.xnc.app
# 短域名（安装器下载 curl -LO xnc.app/setup.exe）；DNS A 记录指向同一台 SRV
XNC_SHORT_DOMAIN=xnc.app
# 首次部署时的 bootstrap 管理员邮箱（留空则部署脚本生成并仅打印一次）
SRV_ADMIN_EMAIL=
# bootstrap 管理员密码（部署脚本自动写入，勿手动填）
SRV_ADMIN_PASSWORD=

# ── NODE_MAIN：主 Windows 测试节点（LABS-TB16G7，Windows 11 Pro）──
# 用途：新版功能、RDP、桌面预览三态
# 传输 = PS Remoting（WinRM 5985，域凭据）；HOST 留空 = 本机本地执行
NODE_MAIN_HOST=
NODE_MAIN_SSH_PORT=22
NODE_MAIN_SSH_USER=
NODE_MAIN_SSH_PASSWORD=
NODE_MAIN_SSH_KEY_PATH=
# Phase 4 RDP 验收用（mstsc 实连），当前阶段可留空
NODE_MAIN_RDP_USER=
NODE_MAIN_RDP_PASSWORD=

# ── NODE2019（预留）：最低版本线节点（Windows Server 2019，不装 pwsh）──
# 用途：Phase 2-4 验证 1809 ConPTY 与 powershell.exe 5.1 降级
NODE2019_HOST=
NODE2019_SSH_PORT=22
NODE2019_SSH_USER=
NODE2019_SSH_PASSWORD=
NODE2019_SSH_KEY_PATH=

# ── NODELINUX（预留，可选）：跨平台守门（Ubuntu x64）──
# 用途：Phase 8 预研：编译目标、PTY 抽象冒烟
NODELINUX_HOST=
NODELINUX_SSH_PORT=22
NODELINUX_SSH_USER=
NODELINUX_SSH_PASSWORD=
NODELINUX_SSH_KEY_PATH=
